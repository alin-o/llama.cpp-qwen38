# ggml-org Q4_K_M trunk: no embedded MTP head, so the separate head file is
# auto-loaded from the cache root (mtp-Qwen3.8-27B-Q4_0.gguf).
# CTX=128000 OOMs in 24G (trunk ~1.4 GB bigger than Q4_K_XL plus the ~1.3 GiB
# MTP buffer); 65536 frees ~2 GiB of KV. If still tight: CACHE_PROFILE=q8turbo3
# (smallest KV) or CTX=49152.
# /models model dir (unsloth store, holds the mmproj); compose default is the
# cache root, so name it here.
MODELS_DIR=/mnt/S/.cache/llama.cpp
QWEN38_UPSTREAM_PORT=8881
MODEL_GGUF=/models/qwen38/Qwen3.8-27B-Q4_K_M.gguf
MTP_GGUF=/models/qwen38/mtp-Qwen3.8-27B-Q4_0.gguf
MMPROJ_GGUF=/models/qwen38/mmproj-BF16.gguf
CACHE_PROFILE=turbo3
SPEC=mtp
CTX=64000
NP=1
DRAFT_MAX=3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
CACHE_RAM_MIB=16384
NO_BUILD=1
