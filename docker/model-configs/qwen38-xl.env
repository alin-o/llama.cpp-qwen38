# Unsloth Q4_K_XL trunk with embedded MTP head and full prompt capture.
# Prompt logs contain raw system instructions, tools, and conversation content;
# keep /state/prompt-logs local and do not commit or publish it.
MODELS_DIR=/mnt/S/.cache/llama.cpp
QWEN38_UPSTREAM_PORT=8881
MODEL_GGUF=/models/qwen38/Qwen3.8-27B-UD-Q4_K_XL.gguf
MMPROJ_GGUF=/models/qwen38/mmproj-BF16.gguf
#CHAT_TEMPLATE_FILE=/models/qwen38/Qwen3.8-developer.jinja
#REASONING_FORMAT=deepseek
#PROMPT_LOG_DIR=/state/prompt-logs/qwen38-xl
CACHE_PROFILE=turbo3
FIT=off
SPEC=mtp
CTX=128000
NP=4
DRAFT_MAX=3
DRAFT_CACHE_K=turbo3
DRAFT_CACHE_V=turbo3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
CACHE_RAM_MIB=16384
NO_BUILD=1
