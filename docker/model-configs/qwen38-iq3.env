# GSQ-RCO IQ3_XXS trunk: no embedded MTP tensors, so use the compatible
# standalone Qwen3.8-27B Q4_0 MTP head from the qwen38 cache.
QWEN38_UPSTREAM_PORT=8881
MODEL_GGUF=/models/qwen38/Qwen3.8-27B-GSQ-RCO-IQ3_XXS.gguf
MTP_GGUF=/models/qwen38/mtp-Qwen3.8-27B-Q4_0.gguf
MMPROJ_GGUF=/models/qwen38/mmproj-Qwen3.8-27B-BF16.gguf
CACHE_PROFILE=turbo3
SPEC=mtp
CTX=128000
NP=2
DRAFT_MAX=3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
CACHE_RAM_MIB=16384
NO_BUILD=1
