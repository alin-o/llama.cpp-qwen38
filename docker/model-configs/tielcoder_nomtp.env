# Benchmark twin of tielcoder.env: identical weights/config, SPEC=off (no MTP).
# Use to measure the MTP speedup: run the WITH-MTP pass (MODEL=tielcoder) and
# this WITHOUT-MTP pass (MODEL=tielcoder_nomtp), same prompt/length/temperature.
#   ./run.sh tielcoder                 # WITH MTP  (SPEC=mtp, embedded head)
#   SPEC=off ./run.sh tielcoder        # one-off WITHOUT MTP, no new file
#   ./run.sh tielcoder_nomtp           # or use this dedicated benchmark twin
MODEL_GGUF=/models/Tiel-Coder-35B-A3B-MTP-UD-Q4_K_S.gguf
MMPROJ_GGUF=/models/mmproj-BF16.gguf
# SPEC=off disables the MTP draft head entirely (no --spec-type).
SPEC=off
QWEN38_UPSTREAM_PORT=8881
CACHE_PROFILE=turbo3
CTX=128000
NP=4
SLOT_PROMPT_CACHE_THRESHOLD=0.75
CACHE_RAM_MIB=16384
NO_BUILD=1
