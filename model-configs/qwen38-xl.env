# Unsloth Q4_K_XL trunk with embedded MTP head and full prompt capture.
# Prompt logs contain raw system instructions, tools, and conversation content;
# keep /state/prompt-logs local and do not commit or publish it.
QWEN38_MODEL_DIR=/mnt/S/.cache/llama.cpp/qwen38/unsloth-Qwen3.8-27B-GGUF-27af057e
QWEN38_UPSTREAM_PORT=8881
MODEL_ENTRYPOINT=/docker/run-model-server.sh
MODEL_GGUF=/models/Qwen3.8-27B-UD-Q4_K_XL.gguf
MMPROJ_GGUF=/models/mmproj-BF16.gguf
