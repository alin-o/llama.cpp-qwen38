# unsloth Q4_K_XL trunk: embeds its own MTP head (blk.64.* tensors), so
# run-upstream-server.sh does not pass --spec-draft-model.
# No MODEL_GGUF: the container default is /models/Qwen3.8-27B-UD-Q4_K_XL.gguf.
QWEN38_UPSTREAM_PORT=8881
CACHE_PROFILE=turbo3
SPEC=mtp
CTX=128000
NP=1
DRAFT_MAX=3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
# A/B with the DSpark drafter instead: set SPEC=dspark; DRAFT_GGUF selects
# the conversion (script default is Qwen3.8-27B-DSpark-Q8_0.gguf):
# SPEC=dspark
# DRAFT_GGUF=/models/DSpark/Qwen3.8-27B-DSpark-Q8_0-magnitude.gguf
NO_BUILD=1