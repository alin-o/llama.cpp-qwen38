# Unsloth Ornith-1.5-35B-A3B UD-Q4_K_S, manually downloaded into the cache
# root (19.4 GiB), i.e. host /mnt/S/.cache/llama.cpp/ (sandbox /models).
# Not part of the qwen38 stack: uses the generic entrypoint (no Qwen3.8
# chat template, no mmproj, no embedded-head magic). The weight file is
# NOT in the qwen38/ subdir, so widen the /qwen38-cache mount to the full
# cache root (the qwen38 configs keep the narrower default).
QWEN38_CACHE_ROOT=/mnt/S/.cache/llama.cpp
# 19.4 GiB of weights leaves little KV headroom on the 24 GB card: start at
# CTX=32768 with the small turbo3 KV and raise CTX if it fits.
QWEN38_UPSTREAM_PORT=8881
MODEL_ENTRYPOINT=/qwen38/run-model-server.sh
MODEL_GGUF=/qwen38-cache/Unsloth-Ornith-1.5-35B-A3B-UD-Q4_K_S.gguf
# SPEC=off: the compose file defaults SPEC=mtp for the qwen38 stack and that
# would leak in; the generic entrypoint has no MTP head to load.
SPEC=off
CACHE_PROFILE=turbo3
CTX=128000
NP=1
SLOT_PROMPT_CACHE_THRESHOLD=0.75
NO_BUILD=1
