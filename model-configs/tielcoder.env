# peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF-MTP UD-Q4_K_S: Ornith-1.5-35B-A3B
# (qwen35moe) re-quantized with the author's imatrix; the Sharp chat template
# and a 0.9 GB MTP head are embedded in the trunk GGUF. Manually downloaded
# into the cache root (21.8 GB), i.e. host /mnt/S/.cache/llama.cpp/
# (sandbox /models).
# Not part of the qwen38 stack: generic entrypoint (--jinja picks up the
# template shipped inside the GGUF, so no Qwen3.8 template/mmproj). The weight
# file is NOT in the qwen38/ subdir, so widen the /qwen38-cache mount to the
# full cache root (the qwen38 configs keep the narrower default).
QWEN38_CACHE_ROOT=/mnt/S/.cache/llama.cpp
QWEN38_UPSTREAM_PORT=8881
MODEL_ENTRYPOINT=/docker/run-model-server.sh
MODEL_GGUF=/qwen38-cache/Tiel-Coder-35B-A3B-MTP-UD-Q4_K_S.gguf
MMPROJ_GGUF=/qwen38-cache/mmproj-BF16.gguf
# MTP head is embedded in MODEL_GGUF (nextn.* tensors): SPEC=mtp without a
# separate MTP_GGUF runs it via --spec-type draft-mtp.
SPEC=mtp
# Q4_K_S (20.3 GiB) leaves little KV headroom on the 24 GB card (the README's
# benchmarked tier, Q4_K_XL at 21.7 GiB, is too tight here): small turbo3 KV,
# raise CTX or drop NP if it fits. If OOM: lower CTX or CACHE_PROFILE=q8turbo3.
CACHE_PROFILE=turbo3
CTX=128000
NP=2
SLOT_PROMPT_CACHE_THRESHOLD=0.75
NO_BUILD=1
