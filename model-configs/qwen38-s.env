# unsloth Q4_K_S trunk: also embeds its MTP head, same path as qwen38-xl.
# ~2 GB smaller than Q4_K_XL, so CTX=128000 has comfortable headroom.
QWEN38_UPSTREAM_PORT=8881
MODEL_GGUF=/qwen38-cache/Qwen3.8-27B-UD-Q4_K_S.gguf
CACHE_PROFILE=turbo4
SPEC=mtp
CTX=128000
NP=1
DRAFT_MAX=3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
NO_BUILD=1