# unsloth Q4_K_S trunk: also embeds its MTP head, same path as qwen38-xl.
# ~2 GB smaller than Q4_K_XL, so CTX=128000 has comfortable headroom.
# /models model dir (unsloth store, holds the mmproj); compose default is the
# cache root, so name it here.
QWEN38_MODEL_DIR=/mnt/S/.cache/llama.cpp/qwen38/unsloth-Qwen3.8-27B-GGUF-27af057e
QWEN38_UPSTREAM_PORT=8881
MODEL_GGUF=/qwen38-cache/Qwen3.8-27B-UD-Q4_K_S.gguf
CACHE_PROFILE=turbo4
SPEC=mtp
CTX=128000
NP=8
DRAFT_MAX=3
SLOT_PROMPT_CACHE_THRESHOLD=0.75
NO_BUILD=1

KV_PAGED=1
KV_BLOCK_SIZE=64
# Block counts are fixed below; the large-context MTP fit probe crashes before
# startup and has nothing left to tune here.
FIT=off
N_GPU_BLOCKS=2048
N_CPU_BLOCKS=64
KV_PAGED_WATERMARK=0

PROMPT_LOG_DIR=/state/prompt-logs/qwen38-s
